# Security
# Set a random, secure string in production
SECRET_KEY=change_this_to_a_secure_random_string_in_production

# Paths (can be overridden in docker-compose)
# Mounts the local ./data or ./output folder to the container
VIDEO_FOLDER=/app/output

# RTMP Settings
# The local ingest URL for Nginx. Usually does not need changing.
RTMP_SERVER_URL=rtmp://nginx-rtmp:1935/live/stream

# Flask Settings
FLASK_ENV=production
DEBUG=false

# Note: Stream keys and external destinations 
# (YouTube, Facebook, etc.) are managed dynamically 
# via the Dashboard UI and stored securely in the local SQLite database.
